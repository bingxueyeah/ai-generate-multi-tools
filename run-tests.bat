@echo off
REM Windows批处理脚本 - 运行自动化测试
echo ============================================================
echo HTML工具生成器 - 自动化测试运行脚本
echo ============================================================
echo.

REM 检查Maven是否安装
where mvn >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo 错误: 未找到Maven，请先安装Maven并添加到PATH
    exit /b 1
)

echo 正在运行测试...
echo.

REM 运行Maven测试
call mvn test

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ============================================================
    echo 测试执行完成！
    echo ============================================================
) else (
    echo.
    echo ============================================================
    echo 测试执行失败！
    echo ============================================================
    exit /b 1
)

pause

